{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 450,
  "fit-to-screen": true,
  "control-center-margin-top": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 12,
  "notification-window-width": 450,
  "widgets": [
    "mpris",
    "dnd",
    "buttons-grid",
    "volume",
    "notifications"
  ],
  "widget-config": {
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 60,
      "image-radius": 8
    },
    "notifications": {
      "text": "Notifications"
    },
    "volume": {
      "label": "󰕾"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰤨",
          "type": "toggle",
          "command": "nmcli radio wifi on",
          "update-command": "~/.config/scripts/wifi-check.sh"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "command": "~/.config/scripts/bt-check.sh"
        },
        {
          "label": "󰖔",
          "type": "toggle",
          "active": false,
          "command": "~/.config/scripts/nightshift.sh",
          "update-command": "~/.config/scripts/nightshift-check.sh"
        },
        {
          "label": "󰍃",
          "type": "action",
          "command": "hyprlock"
        },
        {
          "label": "󰐥",
          "type": "action",
          "command": "systemctl poweroff"
        }
      ]
    }
  }
}
