{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 4,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": ["hyprland/window"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["group/system-cluster"],

  "hyprland/window": {
    "format": "{title}",
    "separate-outputs": true,
    "rewrite": {
      "": "Desktop",           // If title is empty, show Desktop
      "(.*) — Mozilla Firefox": "Firefox", // Example: clean up titles
      "(.*) - Visual Studio Code": "VS Code"
    },
    "max-length": 50
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "active": "󰮯",
      "default": "󰊠",
      "urgent": "󰀨"
    }
  },

  "group/system-cluster": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "pulseaudio",
      "custom/ascii-vol",
      "clock",
      "custom/notification"
    ]
  },

  "network": { "format-wifi": "󰤨", "format-ethernet": "󰈀", "format-disconnected": "󰤭" },
  "pulseaudio": { "format": "{icon}", "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] }, "on-click": "pavucontrol" },
  "custom/ascii-vol": {
    "exec": "~/.config/waybar/scripts/volume-ascii.sh",
    "interval": 1,
    "format": "{}",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip": false
  },
  "clock": { "format": "󰥔 {:%I:%M %p}" },
  "custom/notification": {
    "format": "{icon}",
    "format-icons": { "notification": "󱅫", "none": "󰂚" },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true
  }
}
