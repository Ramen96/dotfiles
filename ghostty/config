# Theme
# theme = light:Belafonte Day, dark:Belafonte Night Bright
theme = light:Belafonte Day, dark:Dracula+

# Font
font-size = 18

# Cursor
cursor-style = block
cursor-style-blink = true

# Shell Integration
shell-integration-features = no-cursor

# Clipboard
clipboard-read = allow
clipboard-write = allow

# Transparancy
background-opacity = 0.8
background-blur = macos-glass-regular

